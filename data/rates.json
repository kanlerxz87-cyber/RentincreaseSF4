          "source_note": ""
        },
        {
          "id": "RATE-14",
          "label": "Current legal status of File No. 261020",
          "value": "'Pending Committee Action'; Land Use and Transportation Committee; no final action, no enactment date, no enactment number",
          "status": "verified",
          "source_ids": [
            "S71"
          ],
          "notes": "Introduced 9/15/2026; referred to department 9/18/2026 and 9/30/2026; Youth Commission response received 10/7/2026. Not enacted, so it creates no limit today.",
          "flag_id": "F46",
          "source_note": ""
        },
        {
          "id": "RATE-15",
          "label": "Proposed applicability date",
          "value": "If enacted as proposed: banked increases noticed on or after September 15, 2026, and capital improvement increases based on petitions filed on or after September 15, 2026",
          "status": "verified",
          "source_ids": [
            "S72"
          ],
          "notes": "SF.gov states 'This legislation has not been enacted and is subject to change.' How a notice served before enactment would be treated is not stated.",
